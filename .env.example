# Für die Import-Skripte (scripts/geocode.ts, scripts/import.ts) und später
# für die App. Als .env.local anlegen, nie committen.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Von der App (Baustein 2) genutzt, darf öffentlich sein — liest nur "venues".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Für den Meldeknopf auf der Detailseite (server-seitiger Mailversand über
# Resend). Nie mit NEXT_PUBLIC_ Präfix — diese Werte dürfen nie im Browser
# landen. REPORT_TO_EMAIL ist die Adresse, an die Meldungen gehen und an
# die auch geantwortet wird. REPORT_FROM_EMAIL ist die Absenderadresse,
# braucht eine bei Resend verifizierte Domain (z. B. "Kaverne
# <meldungen@kaverne.app>").
RESEND_API_KEY=
REPORT_TO_EMAIL=
REPORT_FROM_EMAIL=
